DEFINE SCHEMA

RECORD TYPE FinancesRecord (
    "___createTime" TIMESTAMP,
    "___createdBy" REFERENCE,
    "___etag" STRING,
    "___modTime" TIMESTAMP,
    "___modifiedBy" REFERENCE,
    "___recordID" REFERENCE,
    asset ASSET,
    assetFilename STRING,
    assetMIMEType STRING,
    assetSHA256 STRING,
    domainType STRING,
    hash STRING,
    mutationID STRING,
    operation STRING,
    parentID STRING,
    payload STRING,
    schemaVersion INT64
);

RECORD TYPE Users (
    "___createTime" TIMESTAMP,
    "___createdBy" REFERENCE,
    "___etag" STRING,
    "___modTime" TIMESTAMP,
    "___modifiedBy" REFERENCE,
    "___recordID" REFERENCE,
    roles LIST<INT64>,
    GRANT WRITE TO "_creator",
    GRANT READ TO "_world"
);
